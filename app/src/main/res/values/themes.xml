<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KidShieldPro" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/bg_midnight</item>
        <item name="android:navigationBarColor">@color/bg_midnight</item>
        <item name="android:windowBackground">@color/bg_midnight</item>
    </style>

    <style name="Theme.KidShieldPro.Translucent" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.75</item>
    </style>
</resources>
